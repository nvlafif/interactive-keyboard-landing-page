---
import { faqs } from '../data/site';
---

<section id="faq" class="bg-slate-950 py-16 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="text-center">
      <span class="font-mono text-xs font-bold tracking-wider text-cyan-400 uppercase">FAQ</span>
      <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-white sm:text-3xl">
        Pertanyaan Seputar Atom Pro83 (MK913)
      </h2>
    </div>

    <div class="mt-10 space-y-3.5">
      {faqs.map((faq) => (
        <details class="group rounded-2xl border border-slate-800 bg-slate-900/75 p-5 transition open:border-cyan-500/50 open:bg-slate-900">
          <summary
            style="touch-action: manipulation;"
            class="flex min-h-[32px] cursor-pointer list-none items-center justify-between gap-4 text-sm font-bold text-white select-none sm:text-base"
          >
            <span>{faq.question}</span>
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-slate-800 text-slate-300 transition group-open:rotate-45 group-open:bg-cyan-500/20 group-open:text-cyan-400">
              +
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-400">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
