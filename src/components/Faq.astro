---
import { faqs } from '../data/site';
---

<section id="faq" class="py-20 sm:py-24">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <div class="text-center">
      <span class="text-xs font-bold tracking-wider text-indigo-600 uppercase">FAQ</span>
      <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
        Pertanyaan yang Sering Diajukan
      </h2>
    </div>

    <div class="mt-10 space-y-3.5">
      {faqs.map((faq) => (
        <details class="group rounded-2xl border border-slate-200 bg-white p-5 transition open:border-indigo-200 open:shadow-xs">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-bold text-slate-900 sm:text-base">
            <span>{faq.question}</span>
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition group-open:rotate-45 group-open:bg-indigo-50 group-open:text-indigo-600">
              +
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>