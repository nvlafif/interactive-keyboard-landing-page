---
import { packages, getWaUrl } from '../data/site';
---

<section id="paket" class="border-y border-slate-800/80 bg-slate-900/50 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <span class="font-mono text-xs font-bold tracking-wider text-cyan-400 uppercase">
        Pilih Varian MK913
      </span>
      <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-white sm:text-4xl">
        Saturn Grey atau Mercury Black — Siap Kirim
      </h2>
      <p class="mt-3 text-sm text-slate-400 sm:text-base">
        Pilih edisi dan konfigurasi switch Fantech Atom Pro83 (MK913) yang paling cocok untuk setup meja Anda.
      </p>
    </div>

    <div class="mt-12 grid gap-7 lg:grid-cols-3">
      {packages.map((pkg) => (
        <div
          class:list={[
            'relative flex flex-col rounded-2xl p-7 transition',
            pkg.popular
              ? 'border-2 border-cyan-400 bg-slate-900 text-white shadow-[0_0_40px_rgba(34,211,238,0.14)] lg:-translate-y-2'
              : 'border border-slate-800 bg-slate-950/90 text-slate-100',
          ]}
        >
          {pkg.popular && (
            <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-gradient-to-r from-cyan-400 to-emerald-400 px-4 py-1 text-xs font-extrabold tracking-wide text-slate-950 uppercase">
              Paling Populer
            </span>
          )}

          <div>
            <h3 class="text-xl font-extrabold text-white">{pkg.name}</h3>
            <p class="mt-1 text-xs text-slate-400">
              {pkg.subtitle}
            </p>
          </div>

          <div class="mt-6 border-b border-slate-800 pb-6">
            <span class="text-xs text-slate-500 line-through">
              {pkg.originalPrice}
            </span>
            <div class="mt-0.5 font-mono text-3xl font-extrabold tracking-tight text-white">
              {pkg.price}
            </div>
          </div>

          <ul class="mt-6 flex-1 space-y-3 text-sm">
            {pkg.features.map((feat) => (
              <li class="flex items-start gap-2.5">
                <svg
                  class:list={['mt-0.5 h-4 w-4 shrink-0', pkg.popular ? 'text-emerald-400' : 'text-cyan-400']}
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-slate-300">{feat}</span>
              </li>
            ))}
          </ul>

          <a
            href={getWaUrl(pkg.waMessage)}
            target="_blank"
            rel="noopener noreferrer"
            style="touch-action: manipulation;"
            class:list={[
              'mt-8 flex min-h-[46px] w-full items-center justify-center rounded-xl py-3.5 text-center text-sm font-bold transition active:scale-[0.98]',
              pkg.popular
                ? 'bg-emerald-500 text-slate-950 hover:bg-emerald-400'
                : 'border border-cyan-500/40 bg-slate-900 text-cyan-300 hover:bg-cyan-500 hover:text-slate-950',
            ]}
          >
            Pesan {pkg.name}
          </a>
        </div>
      ))}
    </div>

    <p class="mt-8 text-center text-xs text-slate-500">
      *Setiap unit dilengkapi kabel USB Type-C, dongle 2.4GHz, dan keycap/switch puller bawaan pabrik.
    </p>
  </div>
</section>
