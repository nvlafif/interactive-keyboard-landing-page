---
import { packages, getWaUrl } from '../data/site';
---

<section id="paket" class="border-y border-slate-200/80 bg-white py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-xs font-bold tracking-wider text-indigo-600 uppercase">
        Pilihan Paket Transparan
      </span>
      <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        Investasi Sekali Bayar, Tanpa Biaya Bulanan
      </h2>
      <p class="mt-3 text-sm text-slate-600 sm:text-base">
        Pilih paket yang paling sesuai dengan tahap bisnis Anda saat ini.
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-3">
      {packages.map((pkg) => (
        <div
          class:list={[
            'relative flex flex-col rounded-2xl p-7 transition',
            pkg.popular
              ? 'border-2 border-indigo-600 bg-slate-900 text-white shadow-xl lg:-translate-y-2'
              : 'border border-slate-200 bg-slate-50 text-slate-900',
          ]}
        >
          {pkg.popular && (
            <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-indigo-600 px-4 py-1 text-xs font-bold tracking-wide text-white uppercase">
              Paling Laris
            </span>
          )}

          <div>
            <h3 class="text-xl font-extrabold">{pkg.name}</h3>
            <p class:list={['mt-1 text-xs', pkg.popular ? 'text-slate-300' : 'text-slate-600']}>
              {pkg.subtitle}
            </p>
          </div>

          <div class="mt-6 border-b pb-6 border-slate-200/20">
            <span class:list={['text-xs line-through', pkg.popular ? 'text-slate-400' : 'text-slate-400']}>
              {pkg.originalPrice}
            </span>
            <div class="mt-0.5 text-3xl font-extrabold tracking-tight">{pkg.price}</div>
          </div>

          <ul class="mt-6 flex-1 space-y-3 text-sm">
            {pkg.features.map((feat) => (
              <li class="flex items-start gap-2.5">
                <svg
                  class:list={['mt-0.5 h-4 w-4 shrink-0', pkg.popular ? 'text-emerald-400' : 'text-indigo-600']}
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                <span class:list={[pkg.popular ? 'text-slate-200' : 'text-slate-700']}>{feat}</span>
              </li>
            ))}
          </ul>

          <a
            href={getWaUrl(pkg.waMessage)}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'mt-8 block w-full rounded-xl py-3.5 text-center text-sm font-bold transition',
              pkg.popular
                ? 'bg-emerald-500 text-slate-950 hover:bg-emerald-400'
                : 'bg-slate-900 text-white hover:bg-indigo-600',
            ]}
          >
            Pilih Paket {pkg.name}
          </a>
        </div>
      ))}
    </div>

    <p class="mt-8 text-center text-xs text-slate-500">
      *Biaya pembelian nama domain (.com / .id) dibayarkan terpisah sesuai tarif registrar resmi agar akun domain menjadi hak milik penuh klien.
    </p>
  </div>
</section>