---
import { siteConfig, getWaUrl } from '../data/site';
---

<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/85 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
    <a href="#" class="flex items-center gap-2.5 text-lg font-extrabold tracking-tight text-slate-900">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-sm font-bold text-white">
        N
      </span>
      <span>{siteConfig.brandName}</span>
    </a>

    <nav class="hidden items-center gap-7 text-sm font-medium text-slate-600 md:flex">
      <a href="#keunggulan" class="transition hover:text-indigo-600">Keunggulan</a>
      <a href="#paket" class="transition hover:text-indigo-600">Paket Harga</a>
      <a href="#faq" class="transition hover:text-indigo-600">FAQ</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={getWaUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full bg-slate-900 px-4 py-2 text-xs font-semibold text-white transition hover:bg-indigo-600 sm:px-5 sm:py-2.5 sm:text-sm"
      >
        <span>Konsultasi Gratis</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>