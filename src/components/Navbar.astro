---
import { siteConfig, getWaUrl } from '../data/site';
---

<header class="sticky top-0 z-40 border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-md">
  <!-- Garis Aksen RGB Tipis khas Side-Panel MK913 -->
  <div class="h-0.5 w-full bg-gradient-to-r from-cyan-500 via-indigo-500 to-amber-400"></div>

  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <a href="#keyboard-test" class="flex items-center gap-2.5 text-base font-extrabold tracking-tight text-white sm:text-lg">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg border border-cyan-400/40 bg-gradient-to-br from-slate-800 to-slate-900 font-mono text-xs font-bold text-cyan-300 shadow-[0_0_12px_rgba(34,211,238,0.2)]">
        83
      </span>
      <span class="flex items-center gap-2">
        <span>{siteConfig.brandName}</span>
        <span class="hidden rounded border border-slate-700 bg-slate-900 px-1.5 py-0.5 font-mono text-[10px] font-bold text-cyan-400 sm:inline-block">
          {siteConfig.modelCode}
        </span>
      </span>
    </a>

    <nav class="hidden items-center gap-7 text-sm font-medium text-slate-300 md:flex">
      <a href="#keyboard-test" class="transition hover:text-cyan-400">Sound Test</a>
      <a href="#keunggulan" class="transition hover:text-cyan-400">Fitur MK913</a>
      <a href="#paket" class="transition hover:text-cyan-400">Varian &amp; Harga</a>
      <a href="#faq" class="transition hover:text-cyan-400">FAQ</a>
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={getWaUrl()}
        target="_blank"
        rel="noopener noreferrer"
        style="touch-action: manipulation;"
        class="inline-flex min-h-[38px] items-center gap-2 rounded-full bg-cyan-500 px-4 py-2 text-xs font-bold text-slate-950 shadow-md shadow-cyan-500/20 transition hover:bg-cyan-400 active:scale-95 sm:px-5 sm:py-2.5 sm:text-sm"
      >
        <span>Pesan MK913</span>
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</header>
