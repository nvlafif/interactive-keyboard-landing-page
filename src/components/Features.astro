---
import { features } from '../data/site';
---

<section id="keunggulan" class="py-20 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-xs font-bold tracking-wider text-indigo-600 uppercase">
        Mengapa Memilih Kami
      </span>
      <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-slate-900 sm:text-4xl">
        Dirancang Khusus untuk Mendongkrak Konversi
      </h2>
      <p class="mt-3 text-sm text-slate-600 sm:text-base">
        Setiap bagian halaman disusun berdasarkan perilaku pengunjung di Indonesia agar langsung paham penawaran Anda dan menekan tombol beli.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((item) => (
        <div class="rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs transition hover:-translate-y-1 hover:border-indigo-200 hover:shadow-md">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600">
            {item.icon === 'bolt' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
            {item.icon === 'mobile' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            )}
            {item.icon === 'target' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
            {item.icon === 'chart' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
              </svg>
            )}
          </div>

          <h3 class="mt-5 text-lg font-bold text-slate-900">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>