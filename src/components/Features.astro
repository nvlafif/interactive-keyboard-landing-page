---
import { features, mk913Specs } from '../data/site';
---

<section id="keunggulan" class="border-t border-slate-800/80 bg-slate-950 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <!-- Ringkasan Spesifikasi Cepat MK913 -->
    <div class="mb-14 grid grid-cols-2 gap-3 sm:grid-cols-4 sm:gap-4">
      {mk913Specs.map((spec) => (
        <div class="rounded-2xl border border-slate-800 bg-slate-900/70 px-4 py-3.5 text-center">
          <div class="font-mono text-[10px] font-bold tracking-wider text-cyan-400 uppercase sm:text-xs">
            {spec.label}
          </div>
          <div class="mt-1 text-xs font-bold text-white sm:text-sm">{spec.value}</div>
        </div>
      ))}
    </div>

    <div class="mx-auto max-w-2xl text-center">
      <span class="font-mono text-xs font-bold tracking-wider text-cyan-400 uppercase">
        Stellar Edition • MK913
      </span>
      <h2 class="mt-2 text-2xl font-extrabold tracking-tight text-white sm:text-4xl">
        Fitur Lengkap di Layout 75% yang Ringkas
      </h2>
      <p class="mt-3 text-sm text-slate-400 sm:text-base">
        Dirancang untuk gaming maupun produktivitas harian dengan koneksi Tri-Mode, peredam silikon internal, dan kontrol knob serbaguna.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {features.map((item) => (
        <div class="group rounded-2xl border border-slate-800 bg-slate-900/75 p-6 transition hover:-translate-y-1 hover:border-cyan-500/50 hover:bg-slate-900">
          <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-cyan-500/20 bg-cyan-500/10 text-cyan-400">
            {item.icon === 'wireless' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.14 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
              </svg>
            )}
            {item.icon === 'switch' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
            )}
            {item.icon === 'knob' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            )}
            {item.icon === 'rgb' && (
              <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            )}
          </div>

          <h3 class="mt-5 text-lg font-bold text-white">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-400">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
